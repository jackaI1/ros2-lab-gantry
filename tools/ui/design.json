        ]
      }
    },
    {
      "name": "Read position",
      "screen": "Jog",
      "kind": "command",
      "payload": {
        "op": "status"
      }
    },
    {
      "name": "Teach mode",
      "screen": "Teach point",
      "kind": "command",
      "payload": {
        "op": "mode",
        "mode": "teach"
      }
    },
    {
      "name": "Record approach",
      "screen": "Teach point",
      "kind": "command",
      "payload": {
        "op": "record",
        "name": "approach",
        "frame": "joint",
        "offset": [
          0,
          0,
          0
        ]
      }
    },
    {
      "name": "Record dispense",
      "screen": "Teach point",
      "kind": "command",
      "payload": {
        "op": "record",
        "name": "dispense",
        "frame": "joint",
        "offset": [
          0,
          0,
          0
        ]
      }
    },
    {
      "name": "Delete approach",
      "screen": "Teach point",
      "kind": "command",
      "payload": {
        "op": "delete",
        "name": "approach"
      }
    },
    {
      "name": "Auto mode",
      "screen": "Run program",
      "kind": "command",
      "payload": {
        "op": "mode",
        "mode": "auto"
      }
    },
    {
      "name": "Run taught cycle",
      "screen": "Run program",
      "kind": "program",
      "payload": [
        {
          "op": "wait_di",
          "channel": 0,
          "value": true,
          "timeout": 30
        },
        {
          "op": "move",
          "point": "approach"
        },
        {
          "op": "move",
          "point": "dispense",
          "offset": [
            0.001,
            0,
            0
          ]
        },
        {
          "op": "set_do",
          "channel": 1,
          "value": true
        },
        {
          "op": "move",
          "point": "approach"
        },
        {
          "op": "set_do",
          "channel": 1,
          "value": false
        }
      ],
      "program_file": "examples/taught-cycle.json"
    },
    {
      "name": "Set ready input",
      "screen": "Run program",
      "kind": "command",
      "payload": {
        "op": "di",
        "channel": 0,
        "value": true
      }
    },
    {
      "name": "Wait for ready",
      "screen": "Run program",
      "kind": "program",
      "payload": {
        "op": "wait_di",
        "channel": 0,
        "value": true,
        "timeout": 5
      }
    },
    {
      "name": "Output 1 on",
      "screen": "Run program",
      "kind": "program",
      "payload": {
        "op": "set_do",
        "channel": 1,
        "value": true
      }
    },
    {
      "name": "Cancel program",
      "screen": "Run program",
      "kind": "cancel",
      "endpoint": "/gantry/pendant/run"
    },
    {
      "name": "Emergency stop",
      "screen": "Fault recovery",
      "kind": "service",
      "endpoint": "/gantry/emergency_stop",
      "payload": {
        "data": true
      }
    },
    {
      "name": "Clear stop input",
      "screen": "Fault recovery",
      "kind": "service",
      "endpoint": "/gantry/emergency_stop",
      "payload": {
        "data": false
      }
    },
    {
      "name": "Reset fault",
      "screen": "Fault recovery",
      "kind": "service",
      "endpoint": "/gantry/reset_fault",
      "payload": {}
    }
  ]
}
