<?xml version="1.0"?>
<sdf version="1.9"><world name="lab">
<physics name="physics" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
<plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
<plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
<plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
<light name="sun" type="directional"><pose>0 0 5 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><direction>0 0 -1</direction></light>
<model name="bench"><static>true</static><link name="top"><collision name="top"><geometry><box><size>1 1 0.02</size></box></geometry></collision><visual name="top"><geometry><box><size>1 1 0.02</size></box></geometry></visual><pose>0 0 -0.02 0 0 0</pose></link></model>
<model name="plate"><static>true</static><pose>0.0895 0.0665 0.015 0 0 0</pose><link name="plate"><visual name="body"><geometry><box><size>0.128 0.086 0.02</size></box></geometry><material><diffuse>0.15 0.4 0.7 1</diffuse></material></visual></link></model>
<!-- Fixed tool stand. Pendant exclusion includes pipette radius and tracking margin. -->
<model name="fixed_tooling"><static>true</static><pose>0.185 0.125 0.0425 0 0 0</pose><link name="stand"><collision name="body"><geometry><box><size>0.03 0.03 0.045</size></box></geometry></collision><visual name="body"><geometry><box><size>0.03 0.03 0.045</size></box></geometry><material><diffuse>0.8 0.25 0.15 1</diffuse></material></visual></link></model>
</world></sdf>
