<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="lab_gantry">
<xacro:arg name="controllers" default=""/>
<link name="world"/>
<xacro:macro name="body" params="name size mass color">
<link name="${name}"><inertial><mass value="${mass}"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial><visual><geometry><box size="${size}"/></geometry><material name="${name}_color"><color rgba="${color}"/></material></visual><collision><geometry><box size="${size}"/></geometry></collision></link>
</xacro:macro>
<xacro:body name="base" size="0.30 0.025 0.025" mass="2" color="0.3 0.3 0.3 1"/>
<joint name="anchor" type="fixed"><parent link="world"/><child link="base"/><origin xyz="0 0 0.25"/></joint>
<xacro:body name="x_carriage" size="0.025 0.22 0.025" mass="0.5" color="0.7 0.7 0.7 1"/>
<xacro:body name="y_carriage" size="0.025 0.025 0.06" mass="0.2" color="0.2 0.6 0.8 1"/>
<xacro:body name="pipette" size="0.008 0.008 0.10" mass="0.05" color="0.9 0.8 0.2 1"/>
<xacro:macro name="axis" params="name parent child xyz axis upper initial">
<joint name="${name}" type="prismatic"><parent link="${parent}"/><child link="${child}"/><origin xyz="${xyz}"/><axis xyz="${axis}"/><limit lower="0" upper="${upper}" effort="100" velocity="0.15"/><dynamics damping="1" friction="0.1"/></joint>
</xacro:macro>
<xacro:axis name="x_joint" parent="base" child="x_carriage" xyz="0 0 0" axis="1 0 0" upper="0.22" initial="0.02"/>
<xacro:axis name="y_joint" parent="x_carriage" child="y_carriage" xyz="0 0 -0.045" axis="0 1 0" upper="0.16" initial="0.02"/>
<xacro:axis name="z_joint" parent="y_carriage" child="pipette" xyz="0 0 -0.06" axis="0 0 -1" upper="0.08" initial="0.01"/>
<ros2_control name="GantrySim" type="system"><hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
<xacro:macro name="controlled" params="name upper initial"><joint name="${name}"><command_interface name="position"><param name="min">0</param><param name="max">${upper}</param></command_interface><state_interface name="position"><param name="initial_value">${initial}</param></state_interface><state_interface name="velocity"/></joint></xacro:macro>
<xacro:controlled name="x_joint" upper="0.22" initial="0.02"/><xacro:controlled name="y_joint" upper="0.16" initial="0.02"/><xacro:controlled name="z_joint" upper="0.08" initial="0.01"/>
</ros2_control>
<gazebo><plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin"><parameters>$(arg controllers)</parameters><position_proportional_gain>10.0</position_proportional_gain></plugin></gazebo>
</robot>
